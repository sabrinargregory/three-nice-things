# ---- Web app (better-auth / Discord OAuth) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the web app (must match the Discord OAuth redirect origin)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# From https://discord.com/developers/applications -> OAuth2
# Redirect URI: {APP_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Discord bot ----
# Same application as above -> Bot tab -> Reset Token
# Enable "Message Content Intent" in the Bot tab (required for reading DMs)
DISCORD_BOT_TOKEN=
# Optional: your dev server's id (enable Developer Mode -> right-click server -> Copy Server ID).
# Slash commands register there instantly on startup; leave blank for slow-propagating global commands.
DISCORD_GUILD_ID=

# ---- AI (OpenRouter) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-haiku-4.5
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Minutes of DM inactivity before the bot starts a fresh AI chat session
CHAT_SESSION_TTL_MINUTES=60
# Max previous messages of the active session sent to the model
CHAT_HISTORY_MAX_MESSAGES=20

# ---- Deployment ----
# Path to the SQLite file (shared by the web app and the bot)
DATABASE_PATH=./data/app.db
# IANA timezone for the 7:00 PM reminder + date rollover, e.g. America/New_York
# Leave unset to use the server's local timezone
REMINDER_TZ=

# Production overrides on the VPS (docker-compose.yml pins DATABASE_PATH itself):
#   APP_URL=https://threenicethings.app
#   BETTER_AUTH_URL=https://threenicethings.app
#   Discord OAuth redirect URI: https://threenicethings.app/api/auth/callback/discord

# ---- Cloudflare Tunnel (VPS only) ----
# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> cloudflared -> copy token.
# Then add a Public Hostname in the dashboard: threenicethings.app -> HTTP -> web:3000
TUNNEL_TOKEN=